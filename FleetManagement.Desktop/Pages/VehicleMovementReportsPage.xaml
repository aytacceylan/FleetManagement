<Page x:Class="FleetManagement.Desktop.Pages.VehicleMovementReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BrushBg}">

    <Page.Resources>
        <Style x:Key="ForceComboBoxStyle" TargetType="ComboBox" BasedOn="{x:Null}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#122B57"/>
            <Setter Property="BorderBrush" Value="#243E70"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="FixDatePickerText" TargetType="{x:Type DatePicker}">
            <Setter Property="Foreground" Value="#0066FF"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="FixCalendar" TargetType="{x:Type Calendar}">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="#a8ccff"/>
        </Style>

        <Style x:Key="ForceComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{x:Null}">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="10,8"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#122B57"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#122B57"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="210"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource FmCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="SEVK SORGULAMA"
                               Foreground="Black"
                               FontSize="22"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Tarih ve kriterlere göre araç hareket kayıtlarını sorgulayın."
                               Margin="0,6,0,0"
                               Foreground="{StaticResource BrushMuted}"/>
                </StackPanel>

                <Button Grid.Column="1"
                            MinWidth="120" Click="ClearFilters_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🧹" FontSize="16" Margin="0,0,6,0" Foreground="#00FFFF"/>
                        <TextBlock Text="Temizle"/>
                    </StackPanel>
                </Button>
                
            </Grid>
        </Border>

        <!-- FILTER -->
        <Border Grid.Row="2" Style="{StaticResource FmCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="SORGULAMA FORMU"
                               Foreground="Black"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1" Width="140" Click="Search_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🔎" FontSize="16" Margin="0,0,6,0" Foreground="#FF6347"/>
                            <TextBlock Text="Sorgula"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3" Width="140" Click="ExportExcel_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="📊" FontSize="16" Margin="0,0,6,0" Foreground="#66CDAA"/>
                            <TextBlock Text="Dışa Aktar"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="5" MinWidth="140" Click="Refresh_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🔄" FontSize="16" Margin="0,0,6,0" Foreground="#FFFF00"/>
                            <TextBlock Text="Yenile"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1. kolon -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="BAŞLANGIÇ TARİHİ"
                                   Foreground="{StaticResource BrushMuted}"
                                   Margin="0,8,0,0"/>
                        <DatePicker x:Name="StartDatePicker"
                                    Margin="0,6,0,10"
                                    Style="{StaticResource FixDatePickerText}"
                                    CalendarStyle="{StaticResource FixCalendar}"/>

                        <TextBlock Text="BİTİŞ TARİHİ"
                                   Foreground="{StaticResource BrushMuted}"/>
                        <DatePicker x:Name="EndDatePicker"
                                    Margin="0,6,0,10"
                                    Style="{StaticResource FixDatePickerText}"
                                    CalendarStyle="{StaticResource FixCalendar}"/>
                    </StackPanel>

                    <!-- 2. kolon -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="PLAKA"
                                   Foreground="{StaticResource BrushMuted}"
                                   Margin="0,8,0,0"/>
                        <ComboBox x:Name="PlateCombo"
                                  Margin="0,6,0,0"
                                  >
                        </ComboBox>

                        <TextBlock Text="SÜRÜCÜ"
                                   Foreground="{StaticResource BrushMuted}"/>
                        <ComboBox x:Name="DriverCombo"
                                    Margin="0,6,0,0"
                                    >
                        </ComboBox>
                    </StackPanel>

                    <!-- 3. kolon -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="GÖREV TÜRÜ"
                                   Foreground="{StaticResource BrushMuted}"
                                   Margin="0,8,0,0"/>
                        <ComboBox x:Name="DutyTypeCombo"
                                  Margin="0,6,0,10">

                        </ComboBox>

                        <TextBlock Text="AİT OLDUĞU TAKIM"
                                   Foreground="{StaticResource BrushMuted}"/>
                        <ComboBox x:Name="UnitCombo"
                                  Margin="0,6,0,10">
                        </ComboBox>
                    </StackPanel>

                    <!-- 4. kolon -->
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="GİDİLEN YER"
                                   Foreground="{StaticResource BrushMuted}"
                                   Margin="0,8,0,0"/>
                        <ComboBox x:Name="RouteCombo"
                                  Margin="0,6,0,10">
                        </ComboBox>

                        <TextBlock Text="ARAÇ MARKA"
           Foreground="{StaticResource BrushMuted}"/>

                        <ComboBox x:Name="VehicleBrandCombo"
                                  Margin="0,6,0,10" >
                            
                        </ComboBox>
                    </StackPanel>

                    <!-- 5. kolon -->
                    <StackPanel Grid.Column="8">

                        <!-- YAPILAN KM -->
                        <TextBlock Text="YAPILAN KM"
               Foreground="{StaticResource BrushMuted}"
               Margin="0,8,0,0"/>

                        <Grid Margin="0,6,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="MinKmTextBox"
                 Grid.Column="0"
                 Padding="8,6"
                 ToolTip="Minimum KM"/>

                            <TextBox x:Name="MaxKmTextBox"
                 Grid.Column="2"
                 Padding="8,6"
                 ToolTip="Maksimum KM"/>
                        </Grid>

                        <!-- GÖREVDE KALINAN SÜRE -->
                        <TextBlock Text="GÖREVDE KALINAN SÜRE (SAAT)"
               Foreground="{StaticResource BrushMuted}"
               Margin="0,2,0,0"/>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="MinDurationTextBox"
                 Grid.Column="0"
                 Padding="8,6"
                 ToolTip="Minimum görev süresi (saat)"/>

                            <TextBox x:Name="MaxDurationTextBox"
                 Grid.Column="2"
                 Padding="8,6"
                 ToolTip="Maksimum görev süresi (saat)"/>
                        </Grid>

                    </StackPanel>


                </Grid>
            </Grid>
        </Border>

        <!-- RESULT -->
        <Border Grid.Row="4" Style="{StaticResource FmCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="SORGULAMA SONUÇLARI"
                               Foreground="{StaticResource BrushMuted}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <!-- EXPORT BUTONU -->
                    <Button Grid.Column="1"
            Width="140"
            Click="ExportExcel_Click">

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="📊"
                       FontSize="16"
                       Margin="0,0,6,0"
                       Foreground="#66CDAA"/>
                            <TextBlock Text="Seçiliyi Aktar" />
                        </StackPanel>

                    </Button>

                    <!-- SONUÇ SAYISI -->
                    <TextBlock Grid.Column="3"
               x:Name="ResultInfoText"
               HorizontalAlignment="Right"
               VerticalAlignment="Center"
               Foreground="{StaticResource BrushMuted}"
               Text="Toplam kayıt: 0"/>

                </Grid>

                <DataGrid x:Name="ResultsGrid"
                          Grid.Row="2"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Extended">
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="S.NO"
                    Binding="{Binding ReportNo}"
                    Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="TARİH" Binding="{Binding DateText}" Width="95"/>
                        <DataGridTextColumn Header="PLAKA" Binding="{Binding Plate}" Width="100"/>
                        <DataGridTextColumn Header="SÜRÜCÜ" Binding="{Binding Driver}" Width="150"/>
                        <DataGridTextColumn Header="ARAÇ MARKA" Binding="{Binding VehicleBrand}" Width="100"/>
                        <DataGridTextColumn Header="GİDİLEN YER" Binding="{Binding Route}" Width="110"/>
                        <DataGridTextColumn Header="GÖREV TÜRÜ" Binding="{Binding DutyType}" Width="80"/>
                        <DataGridTextColumn Header="EMRİNE GİRİLEN BRL/KS" Binding="{Binding Departure}" Width="120"/>
                        <DataGridTextColumn Header="DURUM" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="YAPILAN KM"
                    Binding="{Binding KmText}"
                    Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="GÖREV SÜRESİ"
                    Binding="{Binding DurationText}"
                    Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="TAŞINAN YOLCU" Binding="{Binding PassengerCount}" Width="100"/>
                        <DataGridTextColumn Header="TAŞINAN YÜK" Binding="{Binding LoadAmount}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Page>