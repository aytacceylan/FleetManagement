<Page x:Class="FleetManagement.Desktop.Pages.VehicleMovementsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BrushBg}">

    <Page.Resources>
        <Style x:Key="ForceComboBoxStyle" TargetType="ComboBox" BasedOn="{x:Null}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#122B57"/>
            <Setter Property="BorderBrush" Value="#243E70"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ForceComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{x:Null}">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="10,8"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#122B57"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#122B57"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        
    </Page.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="11"/>
            <RowDefinition Height="290"/>
            <RowDefinition Height="11"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Border Grid.Row="0" Style="{StaticResource FmCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="ARAÇ SEVK HAZIRLA" FontSize="24" Foreground="Black" FontWeight="SemiBold"/>
                    <TextBlock Text="Araç hareket kayıtlarını oluşturun ve takip edin."
                               Margin="0,6,0,0"
                               Foreground="{StaticResource BrushMuted}"/>
                </StackPanel>

                <Button Grid.Column="1" MinWidth="120" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🔄" FontSize="16" Margin="0,0,6,0" Foreground="#FFFF00"/>
                        <TextBlock Text="Yenile"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="3" MinWidth="150" Click="New_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="➕" FontSize="16" Margin="0,0,6,0" Foreground="#9ACD32"/>
                        <TextBlock Text="Yeni Kayıt"/>
                    </StackPanel>
                </Button>

            </Grid>
        </Border>

        <!-- ================= FORM ================= -->
        <Border Grid.Row="2" Style="{StaticResource FmCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- FORM HEADER -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>

                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>

                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>

                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>

                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>

                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>

                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="ARAÇ SEVK HAZIRLIK FORMU"
                               Foreground="Black"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    
                    <Button Grid.Column="1"
                           Width="110" Click="Save_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="💾" FontSize="16" Margin="0,0,6,0" Foreground="#32CD32"/>
                            <TextBlock Text="Kaydet"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3"
        Width="130"
        Click="StartMission_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="▶"
                   Margin="0,0,6,0"
                   Foreground="LimeGreen"/>

                            <TextBlock Text="Görev Başlat"/>

                        </StackPanel>

                    </Button>

                    <Button Grid.Column="5"
        Width="130"
        Click="FinishMission_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="⏹"
                   Margin="0,0,6,0"
                   Foreground="DarkOrange"/>

                            <TextBlock Text="Görev Bitir"/>

                        </StackPanel>

                    </Button>

                    <Button Grid.Column="7"
        Width="130"
        Click="CancelMission_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="❌"
                   Margin="0,0,6,0"
                   Foreground="Red"/>

                            <TextBlock Text="Görev İptal"/>

                        </StackPanel>

                    </Button>

                    <Button Grid.Column="9"
                            Width="110" Click="Delete_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🗑" FontSize="16" Margin="0,0,6,0" Foreground="red"/>
                            <TextBlock Text="Sil"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="11"
                            Width="110" Click="Clear_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🧹" FontSize="16" Margin="0,0,6,0" Foreground="#00FFFF"/>
                            <TextBlock Text="Temizle"/>
                        </StackPanel>
                    </Button>
                    
                </Grid>

                <!-- FORM CONTENT -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 1. KOLON -->
                        <StackPanel Grid.Column="0">
                            
                            <TextBlock Text="ÇIKIŞ NU." Foreground="{StaticResource BrushMuted}" Margin="0,0,0,0"/>
                            <TextBox x:Name="DailyNoBox" Margin="0,6,0,0" IsReadOnly="True"/>


                            <TextBlock Text="PLAKA" Foreground="{StaticResource BrushMuted}"/>
                            <ComboBox x:Name="VehicleCombo"
                                      Margin="0,6,0,0"
                                      DisplayMemberPath="Plate"
                                      SelectedValuePath="Id"
                                      SelectionChanged="VehicleCombo_SelectionChanged"/>



                            <TextBlock Text="SÜRÜCÜ RÜTBESİ ADI SOYADI" Foreground="{StaticResource BrushMuted}"/>
                            <ComboBox x:Name="DriverCombo"
                                     Margin="0,6,0,0"
                                     DisplayMemberPath="Display"
                                     SelectedValuePath="Id">

                            </ComboBox>

                            <TextBlock Text="2. SÜRÜCÜ RÜTBESİ ADI SOYADI" Foreground="{StaticResource BrushMuted}" Margin="0,8,0,0"/>
                            <ComboBox x:Name="SecondDriverCombo"
                                     Margin="0,6,0,0"
                                     DisplayMemberPath="Display"
                                     SelectedValuePath="Id">

                            </ComboBox>
                        </StackPanel>
                        
                        <!-- 2. KOLON -->

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="ARAÇ CİNSİ" Foreground="{StaticResource BrushMuted}" Margin="0,8,0,0"/>
                            <ComboBox x:Name="VehicleTypeCombo"
                                     Margin="0,6,0,0"
                                     DisplayMemberPath="Display"
                                     SelectedValuePath="Id">
                            </ComboBox>

                                <TextBlock Text="ARAÇ KOMUTANI" Foreground="{StaticResource BrushMuted}" Margin="0,8,0,0"/>
                            <ComboBox x:Name="CommanderCombo"
                                        Margin="0,6,0,0"
                                          DisplayMemberPath="Plate"
                                          SelectedValuePath="Id"
                                          SelectionChanged="VehicleCombo_SelectionChanged">

                            </ComboBox>

                            <TextBlock Text="EMRİNE GİRDİĞİ BRL./KS." Foreground="{StaticResource BrushMuted}" Margin="0,8,0,0" />
                            <ComboBox x:Name="DepartureCombo"
                                     Margin="0,6,0,0"
                                     DisplayMemberPath="Display"
                                     SelectedValuePath="Id">
                            </ComboBox>

                            </StackPanel>


                        <!-- 3. KOLON -->
                        <StackPanel Grid.Column="4">

                        <TextBlock Text="YOLCU SAYISI" Foreground="{StaticResource BrushMuted}" Margin="0,8,0,0"/>
                        <TextBox x:Name="PassengerCountBox" Margin="0,5,0,0"/>

                            <TextBlock Text="YÜK MİKTARI" Foreground="{StaticResource BrushMuted}"/>
                            <TextBox x:Name="LoadAmountBox" Margin="0,5,0,0"/>

                            <TextBlock Text="GİDİLECEK YER" Foreground="{StaticResource BrushMuted}" Margin="0,8,0,0"/>
                            <ComboBox x:Name="RouteCombo"
                                     Margin="0,6,0,0"
                                     DisplayMemberPath="Display"
                                     SelectedValuePath="Id">
                            </ComboBox>
                          
                        </StackPanel>

                        <!-- 4. KOLON -->
                        <StackPanel Grid.Column="6">

                            <TextBlock Text="ÇIKIŞ TARİHİ" Foreground="{StaticResource BrushMuted}"/>
                            <DatePicker x:Name="ExitDatePicker"
                                                />

                            <TextBlock Text="ÇIKIŞ SAATİ" Foreground="{StaticResource BrushMuted}" Margin="0,8,0,0"/>
                            <TextBox x:Name="ExitTimeBox" Margin="0,6,0,10" Text="08:00"/>
                            
                            <TextBlock Text="DÖNÜŞ TARİHİ" Foreground="{StaticResource BrushMuted}"/>
                            <DatePicker x:Name="ReturnDatePicker"/>

                            <TextBlock Text="DÖNÜŞ SAATİ" Foreground="{StaticResource BrushMuted}" Margin="0,8,0,0"/>
                            <TextBox x:Name="ReturnTimeBox"
                                     Foreground="Brown"
                                     Margin="0,6,0,0"
                                     TextChanged="ReturnTimeBox_TextChanged"/>

                        </StackPanel>

                        <!-- 5. KOLON -->
                        <StackPanel Grid.Column="8">



                            <TextBlock Text="YAPILAN KM." Foreground="{StaticResource BrushMuted}"/>
                            <TextBox x:Name="DoneKmBox" Margin="0,5,0,0"/>


                            <TextBlock Text="ÇIKIŞ TÜRÜ" Foreground="{StaticResource BrushMuted}" Margin="0,6,0,0"/>
                            <ComboBox x:Name="DutyTypeCombo"
                                     Margin="0,6,0,0"
                                     DisplayMemberPath="Display"
                                     SelectedValuePath="Id">
                            </ComboBox>
                            <TextBlock Text="GÖREV DURUMU" Foreground="{StaticResource BrushMuted}" Margin="0,8,0,0"/>
                            <TextBox x:Name="StatusBox" Margin="0,6,0,10" IsReadOnly="True"/>

                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ================= LIST ================= -->
        <Border Grid.Row="4" Style="{StaticResource FmCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="ARAÇ HAREKET LİSTESİ"
                               Foreground="{StaticResource BrushMuted}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    
                    <Button Grid.Column="1" Width="120" Click="ExportDaily_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="📊" FontSize="16" Margin="0,0,6,0" Foreground="#FFFF00"/>
                            <TextBlock Text="Günlük Aktar"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3" Width="120" Click="ExportMonthly_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="📊" FontSize="16" Margin="0,0,6,0" Foreground="#FFFF00"/>
                            <TextBlock Text="Aylık Aktar"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="5">
                        <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="FilterInfo"
                   Margin="0,6,0,0"
                   Foreground="{StaticResource BrushMuted}"
                   FontSize="12"
                   Text="Toplam kayıt: 0"/>

                        <CheckBox x:Name="ShowAllCheckBox"
                              Content="Tüm kayıtları göster"
                              Margin="10,5"
                              Checked="ShowAllCheckBox_Changed"
                              Unchecked="ShowAllCheckBox_Changed"/>
                    </StackPanel>
                </Grid>



                <DataGrid x:Name="MovementsGrid"
          Grid.Row="2"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          CanUserAddRows="False"
          SelectionMode="Single"
          MinRowHeight="35"
          HorizontalAlignment="Stretch"
          SelectionChanged="MovementsGrid_SelectionChanged">

                    <DataGrid.RowStyle>

                        <Style TargetType="DataGridRow">

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding IsPreviousDayOpen}"
                         Value="True">

                                    <Setter Property="Background"
                        Value="#FFF8C5"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </DataGrid.RowStyle>

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#122B57"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Height" Value="Auto"/>
                            <Setter Property="Padding" Value="4"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#243E70"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="SEVK NO" Binding="{Binding MovementNo}" Width="80"/>
                        <DataGridTextColumn Header="PLAKA" Binding="{Binding Plate}" Width="65"/>

                        <DataGridTemplateColumn Header="SÜRÜCÜ RÜTBESİ ADI SOYADI" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Driver}"
                               TextWrapping="Wrap"
                               TextAlignment="Left"
                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="2. SÜRÜCÜ RÜTBESİ ADI SOYADI" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SecondDriver}"
                               TextWrapping="Wrap"
                               TextAlignment="Left"
                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="ARAÇ CİNSİ" Binding="{Binding VehicleType}" Width="85"/>

                        <DataGridTemplateColumn Header="ARAÇ KOMUTANI" Width="1.5*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Commander}"
                               TextWrapping="Wrap"
                               TextAlignment="Left"
                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="EMRİNE GİRDİĞİ BRL./KS." Width="1.5*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Departure}"
                               TextWrapping="Wrap"
                               TextAlignment="Left"
                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="YOLCU SAYISI" Binding="{Binding PassengerCount}" Width="70"/>
                        <DataGridTextColumn Header="YÜK MİKTARI" Binding="{Binding LoadAmount}" Width="70"/>

                        <DataGridTemplateColumn Header="GİDİLECEK YER" Width="1.5*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Route}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="ÇIKIŞ SAATİ" Binding="{Binding ExitTimeText}" Width="60"/>
                        <DataGridTextColumn Header="DÖNÜŞ SAATİ" Binding="{Binding ReturnTimeText}" Width="60"/>

                        <DataGridTemplateColumn Header="DURUM" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status}"
                               Foreground="{Binding StatusBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="YAPILAN KM" Binding="{Binding KmText}" Width="70"/>

                        <DataGridTemplateColumn Header="ÇIKIŞ TÜRÜ" Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DutyType}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Page>